{
  "name": "iobroker.solaredge-modbus",
  "version": "0.2.0",
  "description": "solaredge-modbus adapter",
  "author": {
    "name": "joergoss",
    "email": "joerg.oss@gmx.de"
  },
  "homepage": "https://github.com/joergoss/ioBroker.solaredge-modbus",
  "license": "MIT",
  "keywords": [
    "solaredge modbus"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joergoss/ioBroker.solaredge-modbus"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^2.5.1",
    "jsmodbus": "^5.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@iobroker/testing": "^6.3.2",
    "@types/chai": "^4.3.0",
    "@types/chai-as-promised": "^8.0.2",
    "@types/gulp": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^22.0.2",
    "@types/sinon-chai": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "axios": "^1.21.1",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.15.0",
    "gulp": "^5.0.1",
    "mocha": "^12.0.3",
    "proxyquire": "^2.1.3",
    "rimraf": "^6.1.4",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf ./build",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:ts",
    "watch:ts": "tsc -p tsconfig.build.json --watch",
    "watch": "npm run watch:ts",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:unit": "mocha test/unit --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint --ext .ts src/",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/joergoss/ioBroker.solaredge-modbus/issues"
  },
  "readmeFilename": "README.md"
}
